# ===========================================
# Citri-Fresh — Variables de Entorno (.env)
# Copia este archivo a .env y completa los valores
# ===========================================

# --- Entorno ---
NODE_ENV=development

# --- Puerto del servidor (local) ---
PORT=3000

# --- Base de datos ---
# Local (SQLite): ruta al archivo local
DB_PATH=./db/citri-fresh.db
# Cloud (Turso/libSQL): URL y token de Turso
# TURSO_DATABASE_URL=libsql://citri-fresh.turso.io
# TURSO_AUTH_TOKEN=

# --- Autenticacion JWT ---
# OBLIGATORIO en produccion. Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Clave maestra para registro de Admin/Auditor ---
# OBLIGATORIO para habilitar creacion de cuentas privilegiadas
ADMIN_ACCESS_KEY=

# --- Cookies cross-origin ---
# Para dominios distintos (frontend vs backend) usar "none" (requiere HTTPS)
COOKIE_SAME_SITE=lax

# --- CORS: origenes permitidos (separados por coma) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# URL del frontend en produccion
CLIENT_URL=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX_REQUESTS=5

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Email (Nodemailer / Ethereal para desarrollo) ---
# Produccion: usar SMTP real (Gmail, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=citri-fresh@localhost

# --- Logger (Pino) ---
LOG_LEVEL=info
