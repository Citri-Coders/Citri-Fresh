# =============================================================================
# 📄 CITRI-FRESH - Configuración de Variables de Entorno
# =============================================================================
# Este archivo es una PLANTILLA para el archivo .env real.
# NO edites este archivo directamente. En su lugar:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita el nuevo archivo .env con tus valores reales
# 3. NUNCA subas .env a Git (ya está en .gitignore)
# =============================================================================

# 🌐 Configuración del Servidor
PORT=3000
NODE_ENV=development

# 🌍 Orígenes permitidos por CORS y dominio del frontend (separados por comas)
# En producción son OBLIGATORIOS; no se permite ningún comodín de dominio.
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 🍪 Cookies: "lax" (mismo sitio) o "none" (frontend/backend en dominios distintos; exige HTTPS)
COOKIE_SAME_SITE=lax

# 🗝️ Configuración de Autenticación JWT
# Genera una clave secreta segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_segura_cambia_en_produccion
JWT_EXPIRES_IN=24h
ADMIN_ACCESS_KEY=tu_clave_maestra_para_registrar_admins

# 💾 Configuración de la Base de Datos SQLite (Local o Turso Cloud)
# Para desarrollo local (archivo):
DB_PATH=./db/citrifresh.db

# Para produccion o SQLite en la nube (Turso):
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu_token_turso

# 🔐 Configuración de Google OAuth 2.0
# Obtén estas credenciales de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google-callback

# 📧 Configuración de Correo Electrónico (para recuperación de contraseña)
# Solo requerido si implementas envío de correos reales
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@citrifresh.com

# 🚀 Configuración de Rate Limiting
# Límites de peticiones por IP (para prevenir ataques)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutos en milisegundos
RATE_LIMIT_MAX_REQUESTS=100    # Máximo de peticiones por ventana
RATE_LIMIT_LOGIN_MAX_REQUESTS=5  # Más estricto para login

# 📊 Configuración de Métricas y Logging
# Nivel de logging: error, warn, info, debug
LOG_LEVEL=info

# =============================================================================
# ⚠️  NOTAS IMPORTANTES:
# =============================================================================
# - Todos los valores entre comillas son ejemplos. REEMPLÁZALOS con valores reales.
# - Para producción, usa NODE_ENV=production
# - JWT_SECRET debe ser único y mantenerse en secreto
# - DATABASE_PATH debe ser una ruta válida donde SQLite pueda escribir
# - En producción, considera usar una base de datos más robusta como PostgreSQL
# =============================================================================
